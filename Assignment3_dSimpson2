#include <stdio.h>
#include <stdlib.h>
// Keeping this array definition local to this file does not depend on an
// unavailable header search path. This is a simple struct to hold an array of doubles and its size.

typedef struct {
    int size;
    double *data;
} Array;

int main() {
    Array myArray;
    myArray.size = 5;
    myArray.data = (double *)malloc(myArray.size * sizeof(double));
    if (myArray.data == NULL) {
        perror("Failed to allocate array");
        return EXIT_FAILURE;
    }

    for (int i = 0; i < myArray.size; i++) {
        myArray.data[i] = i * 1.0; // Initialize with some values
    }

    for (int i = 0; i < myArray.size; i++) {
        printf("Element %d: %f\n", i, myArray.data[i]);
    }

    free(myArray.data);
    return 0;
}

